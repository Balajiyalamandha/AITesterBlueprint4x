# QABuddyAI local config. Copy to .env and fill in. Never commit .env.

# --- Ollama (local embeddings) ---
OLLAMA_URL=http://127.0.0.1:11434
# Leave blank to auto-pick the best available model from
# qwen3-embedding:0.6b -> bge-m3 -> nomic-embed-text.
EMBED_MODEL=

# --- Groq (chat answer only; retrieval never leaves the machine) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
